@file(01_run_genus_dft.tcl) 84: set inc_dirs [list]
@file(01_run_genus_dft.tcl) 85: set rtl_files [list]
@file(01_run_genus_dft.tcl) 87: set fp [open $FLIST r]
@file(01_run_genus_dft.tcl) 88: while {[gets $fp line] >= 0} {
    set line [string trim $line]
    if {$line eq "" || [string match "//*" $line] || [string match "#*" $line]} {
        continue
    }
    # Substitute ${CV32E40P_DIR} dynamically
    regsub -all {\$\{CV32E40P_DIR\}} $line $CV32E40P_DIR line
    
    if {[string match "+incdir+*" $line]} {
        regsub {^\+incdir\+} $line "" dir_path
        lappend inc_dirs $dir_path
    } else {
        lappend rtl_files $line
    }
}
