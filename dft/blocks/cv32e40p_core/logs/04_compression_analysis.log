    [-ratio <integer>]:
        compression ratio used to determine the length of the internal scan channels 
    [-chains <actual_scan_chain>+]:
        name(s) of the actual scan chain(s) to be compressed (default: compress all actual scan chains) 
    [-channel_length <integer>]:
        maximum length of the internal scan channels 
    [-decompressor <string>]:
        type of decompression logic to be built, 'broadcast' or 'xor' (default: broadcast) 
    [-compressor <string>]:
        type of compression logic to be built, 'xor', 'smartscan_xor', 'misr' or 'hybrid' (default: xor) 
    [-mask <string>]:
        specifies to insert masking logic of type 'wide0', 'wide1', or 'wide2' (default is not to insert masking logic) 
    [-mask_sharing_ratio <integer>]:
        number of internal scan channels sharing a mask register 
    [-auto_create]:
        automatically creates the necessary compression control signals as top-level ports 
    [-master_control <test_signal>]:
        test mode signal used to gate the compression enable and other signals used for compression 
    [-compression_enable <test_signal>]:
        test signal used to enable compression 
    [-spread_enable <test_signal>]:
        test signal used to select test data from the xor-spreader network (required for '-decompressor xor') 
    [-misr_reset_enable <test_signal>]:
        test signal used to reset the MISR registers (required for '-compressor misr') 
    [-misr_reset_clock <test_signal>]:
        use this test_signal to asynchronously reset the MISR registers (allows misr_clock to be shared with existing test clock) 
    [-misr_clock <pin|hpin|port>]:
        use this clock pin to control the MISR registers (required for '-compressor misr') 
    [-misr_shift_enable <test_signal>]:
        test signal used as shift enable for MISR registers 
    [-misr_bypass <test_signal>]:
        test signal used to bypass the MISR logic (required for '-compressor hybrid') 
    [-mask_load <test_signal>]:
        test signal which enables loading of the mask data into the mask registers 
    [-mask_enable <test_signal>+]:
        test signal which controls whether the mask bits should be applied during current scan cycle 
    [-mask_clock <pin|hpin|port>]:
        use this clock pin to control the mask registers 
    [-mask_or_misr_sdi <pin|hpin|port>]:
        scan-data input pin or port used for the dedicated mask/misr scan chain 
    [-mask_or_misr_sdo <pin|hpin|port>]:
        scan-data output pin or port used for the dedicated mask/misr scan chain 
    [-shared_output]:
        whether the scan-data output pin/port of the dedicated mask/misr chain is shared with a functional connection 
    [-create_mask_or_misr_chain]:
        add mask and misr registers to a separate chain 
    [-preview]:
        reports what would be done, but does not modify the netlist 
    [-allow_shared_clocks]:
        allows the misr or mask clock to be shared with an existing full-scan test clock 
    [-inside <inst|hinst>]:
        instance in which to instantiate the compression logic 
    [-apply_timing_constraints]:
        apply the timing constraints for compression on the design 
    [-write_timing_constraints <string>]:
        write the timing constraints for compression to a file 
    [-timing_mode_names <mode>+]:
        timing mode(s) in which to apply timing constraints in case multi mode synthesis is being done 
    [-power_aware]:
        break sub-chains on power domain boundaries 
    [-misr_read <test_signal>]:
        test signal to configure the bidir pads in bidirectional compression 
    [-dont_exploit_inout_scan_io]:
        do not use bidirectional scan compression 
    [-use_all_scan_ios_unidirectionally]:
        do not use bidirectional scan compression 
    [-serial_misr_read]:
        include support for reading the MISR bits serially through the scan data pins 
    [-misr_obs <test_signal>]:
        test signal used to select Serial MISR Read 
    [-target_period <integer>]:
        optimize the compression macro to operate at this target clock period (picoseconds) (defaults to the test_clock period) 
    [-jtag_control_instruction <jtag_instruction>]:
        the JTAG instruction which selects the TDR to control the compression macro 
    [-allow_multiple_jtag_control]:
        allows the insertion of multiple JTAG controlled compression macros 
    [-share_mask_enable_with_scan_in]:
        share the mask enable pin with scan in pin 
    [-low_pin_compression]:
        low pin count compression 
    [-low_pin_comp_control <test_signal>]:
        low pin count compression control pin 
    [-shift_enable <test_signal>]:
        user specified shift enable for low pin count compression (default shift enable is used by default) 
    [-gate_shared_compression_clock]:
        gate the existing mask clock loads 
    [-smartscan_ratio <integer>]:
        length of the deserializer and serializer registers 
    [-smartscan_serial_only]:
        only serial smartscan interface 
    [-smartscan_enable <test_signal>]:
        enables smartscan 
    [-smartscan_parallel_access <test_signal>]:
        enables parallel access of scan-ins 
    [-smartscan_no_update_stage]:
        update registers not to be added 
    [-smartscan_pulse_width_multiplier <integer>]:
        multiplier to widen the clock pulse 
    [-smartscan_serial_scan_ins <pin|hpin|port>+]:
        scan-in(s) of actual scan chain(s) to be used for smartscan serial access 
