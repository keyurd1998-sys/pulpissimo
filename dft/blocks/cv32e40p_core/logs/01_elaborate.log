@file(01_elaborate.tcl) 32: set inc_dirs [list]
@file(01_elaborate.tcl) 33: set rtl_files [list]
@file(01_elaborate.tcl) 34: set fp [open $FLIST r]
@file(01_elaborate.tcl) 35: while {[gets $fp line] >= 0} {
    set line [string trim $line]
    if {$line eq "" || [string match "//*" $line] || [string match "#*" $line]} {
        continue
    }
    regsub -all {\$\{CV32E40P_DIR\}} $line $CV32E40P_DIR line
    if {[string match "+incdir+*" $line]} {
        regsub {^\+incdir\+} $line "" dir_path
        lappend inc_dirs $dir_path
    } else {
        lappend rtl_files $line
    }
}
@file(01_elaborate.tcl) 48: close $fp
